{
	"name": "@flow/ui",
	"version": "0.0.0",
	"private": true,
	"description": "Shared frontend components for Flow and apps that depend on it. Build-less source package — the consuming app's bundler compiles the raw .vue/.ts, exactly like frappe-ui.",
	"type": "module",
	"exports": {
		".": {
			"import": "./src/index.ts",
			"types": "./src/index.ts"
		},
		"./*": {
			"import": "./src/*"
		}
	},
	"peerDependencies": {
		"@tiptap/core": "*",
		"@tiptap/extensions": "*",
		"@tiptap/pm": "*",
		"@tiptap/starter-kit": "*",
		"@tiptap/vue-3": "*",
		"frappe-ui": "*",
		"highlight.js": "*",
		"lucide-vue-next": "*",
		"markdown-it": "*",
		"reka-ui": "*",
		"vue": ">=3.3.0",
		"vue-router": "^4.1.5"
	}
}
